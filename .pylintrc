[MAIN]
ignore=migrations,tests
persistent=no

[MESSAGES CONTROL]
# The repository contains legacy applications with an existing lint backlog.
# CI targets Release 1 code and blocks syntax/import/runtime errors plus unused
# imports and variables. More rules can be enabled as the legacy code is
# modernized without hiding the current baseline behind `exit-zero`.
disable=all
enable=F,syntax-error,undefined-variable,used-before-assignment,not-callable,no-value-for-parameter,too-many-function-args,unexpected-keyword-arg,unused-import,unused-variable

[FORMAT]
max-line-length=100
