# Django
DJANGO_DEBUG=True
SECRET_KEY=change-me-local-only
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL is the primary development database. DATABASE_URL takes
# precedence over the individual DB_* variables below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/su_lms
DB_ENGINE=postgresql
DB_NAME=su_lms
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Frontend integration. Use comma-separated origins to add staging hosts.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=True

# Production security flags. Enable these only when HTTPS is configured.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Development email is written to the console; no mailbox is required.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_FROM_ADDRESS=<noreply@example.com>
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
