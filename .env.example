# Django
DJANGO_DEBUG=True
SECRET_KEY=change-me-local-only
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL is the primary development database. DATABASE_URL takes
# precedence over the individual DB_* variables below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/su_lms
DB_ENGINE=postgresql
DB_NAME=su_lms
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Frontend integration. Use comma-separated origins to add staging hosts.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=True

# Production security flags. Enable these only when HTTPS is configured.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Learning material uploads
MATERIAL_MAX_UPLOAD_SIZE_MB=100
SCORM_MAX_FILES=5000
SCORM_MAX_UNCOMPRESSED_SIZE_MB=500
SCORM_FRAME_ANCESTORS=http://localhost:5173

# File storage. Local media is used when USE_S3=False. For AWS S3, leave
# S3_ENDPOINT_URL empty; for MinIO or another S3-compatible service, set it.
USE_S3=False
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_LOCATION=media
S3_ADDRESSING_STYLE=path
S3_QUERYSTRING_EXPIRE=300

# Development email is written to the console; no mailbox is required.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_FROM_ADDRESS=<noreply@example.com>
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
