# Django Core Settings
DJANGO_DEBUG=True
SECRET_KEY=change-me-use-at-least-50-random-characters-for-this-value
ALLOWED_HOSTS=localhost,127.0.0.1,.pythonanywhere.com,*

# Database Configuration
# Option 1: SQLite (Default, Zero-configuration, recommended for PythonAnywhere free tier & quickstart)
DB_ENGINE=sqlite

# Option 2: PostgreSQL (Set DATABASE_URL or DB_* variables)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/su_lms
# DB_ENGINE=postgresql
# DB_NAME=su_lms
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Option 3: MySQL (e.g. PythonAnywhere MySQL)
# DB_ENGINE=mysql
# DB_NAME=yourusername$default
# DB_USER=yourusername
# DB_PASSWORD=your_mysql_password
# DB_HOST=yourusername.mysql.pythonanywhere-services.com
# DB_PORT=3306

# Frontend & CORS Integration
# Set CORS_ALLOW_ALL_ORIGINS=True to allow API access from any origin (React, Vue, Postman, etc.)
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,https://*.pythonanywhere.com
CORS_ALLOW_CREDENTIALS=True

# Optional university SSO. Leave disabled until Identity Provider credentials
# and the registered callback URI are provided.
OIDC_ENABLED=False
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Production security flags. Enable these only when HTTPS is configured.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Learning material uploads
MATERIAL_MAX_UPLOAD_SIZE_MB=100
SCORM_MAX_FILES=5000
SCORM_MAX_UNCOMPRESSED_SIZE_MB=500
SCORM_FRAME_ANCESTORS=http://localhost:5173

# File storage. Local media is used when USE_S3=False. For AWS S3, leave
# S3_ENDPOINT_URL empty; for MinIO or another S3-compatible service, set it.
USE_S3=False
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_LOCATION=media
S3_ADDRESSING_STYLE=path
S3_QUERYSTRING_EXPIRE=300

# Development email is written to the console; no mailbox is required.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_FROM_ADDRESS=<noreply@example.com>
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
